#include "CLine46.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors/battery_history_request.dtsi>

&default_transform {
    col-offset = <6>;
};


/ {
    trackball_listener {
        status = "okay";
        compatible = "zmk,input-listener";
        device = <&trackball>;
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 14)>,
                <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                <NRF_PSEL(SPIM_MISO, 1, 15)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 14)>,
                <NRF_PSEL(SPIM_MOSI, 1, 15)>,
                <NRF_PSEL(SPIM_MISO, 1, 15)>;
            low-power-enable;
        };
    };
};


&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;  //P0.09を指定(CS)

    trackball: trackball@0 {
        status = "okay";
        compatible = "cormoran,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&xiao_d 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

        // 起動時のデフォルト CPI。実機での追い込みは DYA Studio の「詳細設定」
        // （設定キー cpi@trackball、200-3200 の 200 刻み）で行い、良い値が
        // 固まったらここに反映する。Studio の値はフラッシュにしか無く、
        // ファーム再書き込みや settings_reset.uf2 で消えるため。
        cpi = <600>;

        // 設定キーを cpi@trackball のように人間が読める形にする。
        // 省略するとノードパスの 4 桁ハッシュが使われる。
        settings-id = "trackball";

        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;

        // 軸の入れ替え・反転はこのドライバでは devicetree ではなく
        // CONFIG_PMW3610_SWAP_XY / _INVERT_X / _INVERT_Y（または Studio の
        // 詳細設定 swap_xy / invert_x / invert_y）で行う。
        // 本機の X 反転は下の &trackball_listener 側の zip_xy_transform で
        // 掛けているので、ここでもセンサー側でも重ねて反転しないこと。

        // disable-burst-read は設定しない（既定 = burst read 有効）。
        // 上の &spi0 に cs-gpios があり NCS をコントローラが握れるため、
        // 無効化する理由が無い。
    };
};

// Overrides for the input listener node
&trackball_listener {
    status = "okay";
    input-processors =<&mouse_runtime_input_processor>,
        //<&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>;         //Y軸反転
        //<&zip_xy_transform INPUT_TRANSFORM_XY_SWAP>,        //X軸とY軸の入れ替え
        <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>;       //X軸反転
        //<&zip_temp_layer 2 1000>;                            //オートマウスレイヤーの選択;


    scroller {
        layers = <6>;
        input-processors =
            <&zip_xy_to_scroll_mapper>,          //スクロールモードに変換
            <&scroll_runtime_input_processor>;   //速度・XY反転をDYA Studioから変更可能にする
    };
};

// スクロール専用チェーンの初期値。従来の static processor 構成
// （Y軸反転 → scroll変換 → X軸反転 → 1/8スケール）と同じ体感になるよう設定する。
// DYA Studio から変更した値はフラッシュに保存され、ここでの値より優先される。
&scroll_runtime_input_processor {
    scale-divisor = <8>;
    x-invert;
    y-invert;
};