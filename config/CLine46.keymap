#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        0_base_mac_layer {
            display-name = "0_base_mac";
            bindings = <
&kp TAB            &kp Q   &kp W      &kp E      &kp R              &kp T                                        &kp Y     &kp U   &kp I       &kp O          &kp P             &kp LEFT_BRACKET
&kp LEFT_CONTROL   &kp A   &kp S      &kp D      &kp F              &kp G                                        &kp H     &kp J   &kp K       &kp L          &lt 6 SEMICOLON   &kp RIGHT_BRACKET
&kp LEFT_SHIFT     &kp Z   &kp X      &kp C      &kp V              &kp B                                        &kp N     &kp M   &kp COMMA   &kp PERIOD     &kp SLASH         &kp RIGHT_ALT
                   &kp LEFT_CONTROL   &kp LEFT_GUI   &kp LEFT_ALT   &lt 2 LANG2   &mt LEFT_SHIFT SPACE   &mt LEFT_SHIFT LANG1      &kp RETURN   &lt 3 SPACE   &kp ESCAPE   &kp RETURN
            >;
        };

        1_base_win_layer {
            display-name = "1_base_win";
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
         &trans   &trans   &trans   &trans   &trans   &trans      &trans   &trans                     &trans   &trans
            >;
        };

        2_number_layer {
            display-name = "2_number";
            bindings = <
&kp CARET   &kp EQUAL       &kp N7   &kp N8   &kp N9   &kp AT_SIGN                          &kp LEFT_PARENTHESIS   &kp DOUBLE_QUOTES   &kp RIGHT_PARENTHESIS   &kp SEMICOLON   &kp EXCLAMATION   &kp BACKSLASH
&trans      &kp PLUS        &kp N4   &kp N5   &kp N6   &kp HASH                             &kp LEFT_BRACE         &kp MINUS           &kp RIGHT_BRACE         &kp COLON       &kp AMPERSAND     &kp PIPE
&trans      &kp ASTERISK    &kp N1   &kp N2   &kp N3   &kp UNDERSCORE                       &kp LESS_THAN          &kp UNDERSCORE      &kp GREATER_THAN        &kp SLASH       &kp DOLLAR        &kp PERCENT
            &kp ESCAPE      &kp N0   &trans   &trans   &trans   &trans      &kp RETURN      &trans                                                             &kp QMARK   &trans
            >;
        };

        3_function_layer {
            display-name = "3_function";
            bindings = <
&trans   &trans   &kp F7   &kp F8   &kp F9   &kp F10                        &trans          &kp HOME   &kp UP     &kp END     &kp PAGE_UP     &trans
&trans   &trans   &kp F4   &kp F5   &kp F6   &kp F11                        &kp BACKSPACE   &kp LEFT   &kp DOWN   &kp RIGHT   &kp PAGE_DOWN   &trans
&trans   &trans   &kp F1   &kp F2   &kp F3   &kp F12                        &kp LG(A)       &kp LG(X)  &kp LG(C)  &kp LG(V)   &trans          &trans
         &trans   &trans   &trans   &trans   &trans   &trans      &trans   &trans                                &trans      &trans
            >;
        };

        4_func_win_layer {
            display-name = "4_func_win";
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
         &trans   &trans   &trans   &trans   &trans   &trans      &trans   &trans                     &trans   &trans
            >;
        };

        5_mouse_layer {
            display-name = "5_mouse";
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans     &trans     &trans     &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &mkp MB1   &mkp MB3   &mkp MB2   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans     &trans     &trans     &trans   &trans
         &trans   &trans   &trans   &trans   &trans   &trans      &trans   &trans                         &trans   &trans
            >;
        };

        6_ble_layer {
            display-name = "6_ble";
            bindings = <
&bt BT_CLR       &trans   &trans         &trans         &trans         &trans                                &trans   &trans   &trans   &trans   &trans   &trans
&bt BT_CLR_ALL   &trans   &bt BT_SEL 4   &trans         &trans         &trans                                &trans   &trans   &trans   &trans   &trans   &trans
&trans           &trans   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &trans                                &trans   &trans   &trans   &trans   &trans   &trans
                 &trans   &bt BT_SEL 0   &trans         &trans         &trans   &trans      &studio_unlock   &trans                     &trans   &trans
            >;
        };

        7_reserved_layer {
            display-name = "7_reserved";
            bindings = <
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
&trans   &trans   &trans   &trans   &trans   &trans                        &trans   &trans   &trans   &trans   &trans   &trans
         &trans   &trans   &trans   &trans   &trans   &trans      &trans   &trans                     &trans   &trans
            >;
        };
    };
};