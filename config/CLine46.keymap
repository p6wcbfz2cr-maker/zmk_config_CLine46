#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        L7 {
            bindings = <&mo 7>;
            key-positions = <41 42>;
        };
        MB2 {
            bindings = <&mkp MB2>;
            key-positions = <21 22>;
        };
        MB3 {
            bindings = <&mkp MB3>;
            key-positions = <20 22>;
        };
        L5 {
            bindings = <&mo 5>;
            key-positions = <20 21>;
        };
        L13 {
            bindings = <&mo 11>;
            key-positions = <8 9>;
        };
        Boot {
            bindings = <&bootloader>;
            key-positions = <5 9 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp TAB     &kp Q           &kp W           &kp E           &kp R           &kp T           &kp Y         &kp U          &kp I         &kp O          &kp P            &kp LEFT_BRACKET
&kp LCTRL   &mt RCTRL A     &kp S           &kp D           &kp F           &kp G           &kp H         &kp J          &kp K         &lt 4 L        &mkp MB1         &kp RIGHT_BRACKET
&kp LSHIFT  &mt LSHIFT Z    &kp X           &kp C           &kp V           &kp B           &kp N         &kp M          &kp COMMA     &kp DOT        &mt RSHIFT FSLH  &kp RSHIFT
       &kp TAB         &kp LCTRL  &kp LGUI  &kp LALT  &lt 1 SEMI  &lt 2 LANG2      &lt 7 LANG1  &lt 3 SPACE  &kp RGUI         &kp ENTER
            >;
        };

        symbol {
            bindings = <
&trans      &kp EXCL        &kp AT          &kp HASH        &kp DLLR        &kp PRCNT       &kp CARET     &kp AMPS       &kp STAR      &kp LPAR       &kp RPAR         &trans
&trans      &trans          &kp GRAVE       &kp BSLH        &kp DQT         &none           &kp EQUAL     &kp MINUS      &kp PLUS      &kp LBKT       &kp RBKT         &trans
&trans      &trans          &kp TILDE       &kp PIPE        &kp SQT         &none           &kp UNDER     &kp UNDER      &kp SQT       &kp LBRC       &kp RBRC         &trans
       &kp ESC         &none      &none     &none     &none       &mo 6            &none        &none        &kp LT           &kp GT
            >;
        };

        number {
            bindings = <
&trans      &kp N1          &kp N2          &kp N3          &kp N4          &kp N5          &kp N6        &kp N7         &kp N8        &kp N9         &kp N0           &trans
&trans      &mt RCTRL EXCL  &kp AT          &kp HASH        &kp DLLR        &kp PRCNT       &kp AMPS      &kp STAR       &kp LPAR      &kp RPAR       &kp UNDER        &trans
&trans      &kp LSHIFT      &none           &none           &none           &none           &kp PLUS      &kp MINUS      &kp STAR      &kp DOT        &kp FSLH         &trans
       &trans          &trans     &trans    &trans    &mo 6       &trans           &kp COLON    &kp COLON    &none            &kp EQUAL
            >;
        };

        move {
            bindings = <
&trans      &kp C_BRI_DN    &kp C_BRI_UP    &kp C_MUTE      &kp C_VOL_DN    &kp C_VOL_UP    &kp RC(HOME)  &kp LA(LEFT)   &kp UP        &kp LA(RIGHT)  &kp RC(END)      &trans
&trans      &trans          &kp LA(LS(N3))  &kp LA(LS(N4))  &kp LA(LS(N5))  &trans          &kp BSPC      &kp LEFT       &kp DOWN      &kp RIGHT      &kp RC(E)        &trans
&trans      &trans          &trans          &kp LG(LS(S))   &kp LG(Z)       &kp LG(LS(Z))   &kp RC(D)     &kp LG(LEFT)   &none         &kp LG(RIGHT)  &none            &trans
       &none           &none      &none     &none     &none       &none            &none        &none        &kp RC(LEFT)     &kp RC(RIGHT)
            >;
        };

        mouse {
            bindings = <
&trans      &none           &none           &none           &none           &none           &none         &none          &none         &none          &none            &trans
&trans      &none           &none           &none           &none           &none           &none         &mkp MB1       &mkp MB3      &trans         &mkp MB2         &trans
&trans      &none           &none           &none           &none           &none           &none         &none          &none         &none          &none            &trans
       &none           &none      &none     &none     &none       &none            &none        &none        &none            &none
            >;
        };

        scroll {
            bindings = <
&trans      &none           &none           &none           &none           &none           &none         &none          &none         &none          &none            &trans
&trans      &none           &none           &none           &none           &none           &none         &none          &none         &none          &none            &trans
&trans      &none           &none           &none           &none           &none           &none         &none          &none         &none          &none            &trans
       &none           &none      &none     &none     &none       &none            &none        &none        &none            &none
            >;
        };

        setting {
            bindings = <
&trans      &none           &none           &none           &none           &none           &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4     &trans
&trans      &none           &none           &none           &none           &none           &none         &trans         &trans        &tog 10        &none            &trans
&trans      &none           &trans          &trans          &trans          &none           &none         &none          &none         &none          &none            &trans
       &studio_unlock  &none      &none     &none     &none       &none            &none        &bootloader  &bt BT_CLR       &bt BT_CLR_ALL
            >;
        };

        fkeys {
            bindings = <
&trans      &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &none         &kp LPAR       &kp RPAR      &none          &none            &trans
&trans      &kp F6          &kp F7          &kp F8          &kp F9          &kp F10         &none         &kp LBKT       &kp RBKT      &kp LT         &kp GT           &trans
&trans      &kp F11         &kp F12         &none           &none           &none           &none         &kp LBRC       &kp RBRC      &kp DQT        &kp SQT          &trans
       &none           &none      &none     &none     &none       &none            &none        &none        &none            &none
            >;
        };

        layer_8 {
            bindings = <
&trans      &trans          &trans          &trans          &trans          &trans          &trans        &trans         &trans        &trans         &trans           &trans
&trans      &trans          &trans          &trans          &trans          &trans          &trans        &trans         &trans        &trans         &trans           &trans
&trans      &trans          &trans          &trans          &trans          &trans          &trans        &trans         &trans        &trans         &trans           &trans
       &trans          &trans     &trans    &trans    &trans      &trans           &trans       &lt 9 SPACE  &kp RALT         &trans
            >;
        };

        layer_9 {
            bindings = <
&trans      &kp LS(LC(N1))  &kp LS(LC(N2))  &kp LS(LC(N3))  &kp LS(LC(N4))  &kp LS(LC(N9))  &kp LC(HOME)  &kp HOME       &kp UP        &kp END        &kp LC(END)      &trans
&trans      &trans          &trans          &trans          &trans          &trans          &kp BSPC      &kp LEFT       &kp DOWN      &kp RIGHT      &trans           &trans
&trans      &trans          &trans          &kp LG(LS(S))   &kp LC(Z)       &kp LC(Y)       &kp DEL       &kp PG_UP      &kp DEL       &kp PG_DN      &trans           &trans
       &trans          &trans     &trans    &trans    &trans      &trans           &trans       &trans       &kp LS(LC(TAB))  &kp LC(TAB)
            >;
        };

        precision {
            bindings = <
&trans      &trans          &trans          &trans          &trans          &trans          &none         &none          &none         &none          &none            &trans
&trans      &trans          &trans          &trans          &trans          &trans          &none         &mkp MB1       &mkp MB1      &mkp MB2       &mkp MB1         &trans
&trans      &trans          &trans          &trans          &trans          &trans          &none         &none          &none         &none          &none            &trans
       &trans          &trans     &trans    &trans    &trans      &trans           &none        &none        &none            &tog 10
            >;
        };

        gesture {
            bindings = <
&trans      &none           &none           &none           &none           &none           &none         &none          &kp LC(DOWN)  &none          &none            &trans
&trans      &none           &none           &none           &none           &none           &none         &kp LC(RIGHT)  &none         &kp LC(LEFT)   &none            &trans
&trans      &none           &none           &none           &none           &none           &none         &none          &kp LC(UP)    &none          &none            &trans
       &none           &none      &none     &none     &none       &none            &none        &none        &none            &none
            >;
        };
    };
};
